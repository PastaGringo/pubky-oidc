# Copy to .env.local and fill in.
PORT=4000
# Public URL of this provider, exactly as browsers and clients reach it (no trailing slash).
ISSUER=http://localhost:4000
CLIENT_ID=pubky-ring
# Shared with the relying party. Generate one with: openssl rand -hex 32
CLIENT_SECRET=
# Comma-separated list of allowed redirect URIs of the relying party.
REDIRECT_URIS=http://localhost:8008/_matrix/client/unstable/login/sso/callback/pubky-ring
# Where the signing keys are generated and kept. Keep this file: losing it ends all sessions.
KEYS_FILE=./data/keys.json
# Optional
# NEXUS_URL=https://nexus.pubky.app
# PUBKY_RELAY=
